# =======================================================
# Конфигурация Агента 1С (ПСГ)
# Скопируйте этот файл в .env и укажите ваш реальный API-ключ
# =======================================================

# API-ключ OpenAI (или совместимого провайдера)
OPENAI_API_KEY=sk-proj-your-api-key-here

# (Опционально) Базовый URL для прокси / шлюзов (например, VseGPT, ProxyAPI и др.)
# По умолчанию: https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.vsegpt.ru/v1
